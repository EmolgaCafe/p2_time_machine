#!name=📦 Phoenix 2 Daily Stage Exporter
#!desc=自动提取 LoginResponse 中的每日任务并保存到 Loon 本地
#!author=zy

[Script]
http-response ^https?:\/\/proxy-phoenix2\.firigames\.com\/phoenix2\/backend\/login script-path=https://raw.githubusercontent.com/EmolgaCafe/p2_time_machine/main/p2_daily_exporter.js, requires-body=true, binary-body-mode=true, timeout=10, tag=P2 Daily Exporter

[Mitm]
hostname = proxy-phoenix2.firigames.com